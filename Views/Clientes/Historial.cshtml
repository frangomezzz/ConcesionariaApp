@model ClienteHistorialViewModel
@{ ViewData["Title"] = "Historial de compras"; }
<div class="admin-page"><div class="page-heading d-flex justify-content-between align-items-start gap-3"><div><p class="eyebrow">CLIENTES</p><h1>Historial de compras</h1><p class="page-subtitle">@Model.Cliente.Nombre @Model.Cliente.Apellido</p></div><a class="btn btn-outline-dark" asp-action="Index">← Volver al listado</a></div><div class="client-summary"><div class="initials">@Model.Cliente.Nombre.FirstOrDefault()@Model.Cliente.Apellido.FirstOrDefault()</div><div><small>Nombre completo</small><strong>@Model.Cliente.Nombre @Model.Cliente.Apellido</strong></div><div><small>DNI</small><strong>@Model.Cliente.DNI</strong></div><div><small>Teléfono</small><strong>@Model.Cliente.Telefono</strong></div><div><small>Email</small><strong>@Model.Cliente.Email</strong></div><div><small>Fecha de alta</small><strong>@Model.Cliente.FechaAlta.ToString("dd/MM/yyyy")</strong></div></div><div class="table-card"><div class="card-title-row"><h2>Transacciones registradas</h2></div><div class="table-responsive"><table class="table align-middle mb-0 admin-table"><thead><tr><th>Fecha</th><th>Vehículo</th><th>Vendedor</th><th>Precio final</th><th>Forma de pago</th><th>Estado</th></tr></thead><tbody>@foreach (var sale in Model.Ventas) { <tr><td>@sale.FechaVenta.ToString("dd/MM/yyyy")</td><td><strong>@sale.Vehiculo.Marca @sale.Vehiculo.Modelo</strong><small class="d-block text-muted">@sale.Vehiculo.Anio</small></td><td>@sale.Vendedor.Nombre</td><td class="money">@sale.PrecioFinal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td><td>@Display(sale.MetodoPago)</td><td><span class="status-badge @(sale.Estado == EstadoVenta.Activa ? "status-activo" : "status-inactivo")">@Display(sale.Estado)</span></td></tr> } @if (Model.Ventas.Count == 0) { <tr><td colspan="6" class="empty-state">Este cliente todavía no tiene compras registradas.</td></tr> }</tbody></table></div></div></div>
@functions { string Display(Enum value) => value switch { MetodoPago.Efectivo => "Efectivo", MetodoPago.Tarjeta => "Tarjeta", MetodoPago.FinanciacionPropia => "Financiación", EstadoVenta.Activa => "Activa", EstadoVenta.Anulada => "Anulada", _ => value.ToString() }; }
