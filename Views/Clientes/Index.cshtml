@model PagedResult<Cliente>
@{ ViewData["Title"] = "Gestión de Clientes"; var buscar = Context.Request.Query["buscar"].ToString(); }
<div class="admin-page"><div class="page-heading d-flex justify-content-between align-items-start gap-3"><div><p class="eyebrow">BASE DE CLIENTES</p><h1>Gestión de Clientes</h1><p class="page-subtitle">Administrá los datos de clientes y consultá su historial de compras.</p></div><a class="btn btn-action-primary" asp-action="Nuevo"><span class="material-symbols-rounded">add</span> Nuevo cliente</a></div>@if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }<form method="get" class="filter-card row g-3 align-items-end"><div class="col-md-9"><label class="form-label">Buscar cliente</label><input name="buscar" value="@buscar" class="form-control" placeholder="Nombre, apellido o DNI" /></div><div class="col-md-3 d-flex gap-2"><button class="btn btn-filter flex-grow-1" type="submit"><span class="material-symbols-rounded">search</span> Buscar</button><a class="btn btn-filter" asp-action="Index">Limpiar</a></div></form><div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0 admin-table"><thead><tr><th>Nombre</th><th>DNI</th><th>Teléfono</th><th>Email</th><th>Fecha de alta</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach (var client in Model.Items) { <tr><td><strong>@client.Nombre @client.Apellido</strong><small class="d-block text-muted">Cliente #@client.Id</small></td><td>@client.DNI</td><td>@client.Telefono</td><td>@client.Email</td><td>@client.FechaAlta.ToString("dd/MM/yyyy")</td><td class="text-end text-nowrap"><a class="btn btn-sm btn-action-primary" asp-action="Editar" asp-route-id="@client.Id"><span class="material-symbols-rounded">edit</span> Editar</a> <a class="btn btn-sm btn-action-secondary" asp-action="Historial" asp-route-id="@client.Id"><span class="material-symbols-rounded">history</span> Historial</a></td></tr> } @if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-state">No hay clientes para la búsqueda.</td></tr> }</tbody></table></div><div class="pagination-bar"><span>Mostrando @((Model.Page - 1) * Model.PageSize + (Model.TotalItems == 0 ? 0 : 1)) a @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) de @Model.TotalItems clientes</span><div class="pagination-links">@for (var i = 1; i <= Model.TotalPages; i++) { <a class="@(i == Model.Page ? "active" : "")" asp-action="Index" asp-route-page="@i" asp-route-buscar="@buscar">@i</a> }</div></div></div></div>
