@model MisComisionesViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Mis comisiones";
    var desde = Model.Desde.ToString("yyyy-MM-dd");
    var hasta = Model.Hasta.ToString("yyyy-MM-dd");
}
<div class="admin-page commissions-page">
    <div class="page-heading d-flex justify-content-between align-items-start gap-3"><div><p class="eyebrow">GESTIÓN COMERCIAL</p><h1>Mis comisiones</h1><p class="page-subtitle">Resumen y detalle de las comisiones generadas.</p></div></div>
    <form method="get" class="filter-card row g-3 align-items-end commission-filter"><div class="col-md-4"><label class="form-label">Desde</label><input type="date" name="desde" value="@desde" class="form-control" /></div><div class="col-md-4"><label class="form-label">Hasta</label><input type="date" name="hasta" value="@hasta" class="form-control" /></div><div class="col-md-4 d-flex gap-2"><button class="btn btn-filter flex-grow-1" type="submit"><span class="material-symbols-rounded">filter_alt</span> Aplicar rango</button></div></form>
    <div class="metric-grid"><article class="metric-card"><div class="metric-icon metric-icon-green"><span class="material-symbols-rounded">payments</span></div><p>Comisión del mes</p><strong>@Model.ComisionMes.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</strong><small>Mes calendario actual</small></article><article class="metric-card"><div class="metric-icon metric-icon-blue"><span class="material-symbols-rounded">account_balance</span></div><p>Comisión total</p><strong>@Model.ComisionTotal.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</strong><small>@Model.Desde.ToString("dd/MM/yyyy") - @Model.Hasta.ToString("dd/MM/yyyy")</small></article><article class="metric-card"><div class="metric-icon metric-icon-gray"><span class="material-symbols-rounded">directions_car</span></div><p>Ventas comisionables</p><strong>@Model.VentasComisionables</strong><small>Operaciones activas en el rango</small></article></div>
    <div class="table-card commission-detail-card"><div class="card-title-row"><h2>Detalle de comisiones</h2></div><div class="table-responsive"><table class="table align-middle mb-0 admin-table"><thead><tr><th>Venta</th><th>Fecha</th><th>Precio base</th><th>% Comisión aplicado</th><th>Comisión</th><th>Estado</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr class="@(item.Estado == EstadoVenta.Anulada ? "row-inactive" : "")"><td><a class="sale-table-link" asp-action="Detalle" asp-route-id="@item.Id"><strong>@item.Vehiculo</strong></a><small class="d-block text-muted">Cliente: @item.Cliente</small></td><td>@item.FechaVenta.ToString("dd/MM/yyyy")</td><td class="money">@item.PrecioBase.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</td><td>@item.PorcentajeComision.ToString("0.###", CultureInfo.InvariantCulture)%</td><td class="money commission-value">@item.Comision.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</td><td><span class="status-badge @(item.Estado == EstadoVenta.Activa ? "status-activo" : "status-anulada")">@(item.Estado == EstadoVenta.Activa ? "Activa" : "Anulada")</span></td></tr> } @if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-state">No hay ventas en el rango seleccionado.</td></tr> }</tbody></table></div><div class="pagination-bar"><span>Mostrando @((Model.Page - 1) * Model.PageSize + (Model.TotalItems == 0 ? 0 : 1)) a @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) de @Model.TotalItems ventas</span><div class="pagination-links">@for (var i = 1; i <= Model.TotalPages; i++) { <a class="@(i == Model.Page ? "active" : "")" href="@Url.Action("MisComisiones", "Ventas", new { page = i, desde, hasta })">@i</a> }</div></div></div>
</div>
