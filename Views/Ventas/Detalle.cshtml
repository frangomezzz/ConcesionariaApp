@model VentaDetalleViewModel
@using System.Globalization
@{
    var sale = Model.Venta;
    ViewData["Title"] = $"Venta #{sale.Id}";
}
<div class="sale-detail-page">
    <div class="page-heading sale-detail-heading d-flex justify-content-between align-items-start gap-3"><div><p class="eyebrow">DETALLE DE OPERACIÓN</p><div class="detail-title-line"><h1>Venta #@sale.Id</h1><span class="status-badge @(sale.Estado == EstadoVenta.Activa ? "status-activo" : "status-anulada")">@(sale.Estado == EstadoVenta.Activa ? "Activa" : "Anulada")</span></div><p class="page-subtitle">Fecha: @sale.FechaVenta.ToString("dd/MM/yyyy")</p></div><a class="btn btn-outline-secondary" asp-action="@(User.IsInRole("Admin") ? "Index" : "MisVentas")">Volver</a></div>
    @if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
    @if (Model.Error is not null) { <div class="alert alert-danger">@Model.Error</div> }
    <div class="detail-layout">
        <div class="detail-main-column">
            <section class="detail-card"><h2><span class="material-symbols-rounded">person</span> Datos del cliente</h2><div class="detail-grid"><div><small>Nombre completo</small><strong>@sale.Cliente.Nombre @sale.Cliente.Apellido</strong></div><div><small>DNI</small><strong>@sale.Cliente.DNI</strong></div><div><small>Teléfono</small><strong>@sale.Cliente.Telefono</strong></div><div><small>Email</small><strong>@sale.Cliente.Email</strong></div></div></section>
            <section class="detail-card"><h2><span class="material-symbols-rounded">directions_car</span> Vehículo</h2><div class="detail-grid"><div class="detail-grid-wide"><small>Marca / modelo</small><strong>@sale.Vehiculo.Anio @sale.Vehiculo.Marca @sale.Vehiculo.Modelo</strong></div><div><small>Año</small><strong>@sale.Vehiculo.Anio</strong></div><div><small>Tipo</small><strong>@Display(sale.Vehiculo.Tipo)</strong></div><div><small>Color</small><strong>@sale.Vehiculo.Color</strong></div><div><small>Patente</small><strong>@(sale.Vehiculo.Patente ?? "Sin patentar")</strong></div><div><small>Condición</small><strong>@(sale.Vehiculo.EsUsado ? "Usado" : "0km")</strong></div></div></section>
            @if (sale.Estado == EstadoVenta.Anulada)
            {
                <section class="detail-card cancellation-card"><h2><span class="material-symbols-rounded">cancel</span> Datos de anulación</h2><div class="detail-grid"><div><small>Fecha de anulación</small><strong>@sale.FechaAnulacion?.ToString("dd/MM/yyyy HH:mm")</strong></div><div><small>Anulada por</small><strong>@(sale.AnuladoPorUsuario?.Nombre ?? "Administrador")</strong></div><div class="detail-grid-wide"><small>Motivo</small><strong>@sale.MotivoAnulacion</strong></div></div></section>
            }
        </div>
        <aside class="financial-card"><h2><span class="material-symbols-rounded">payments</span> Detalle financiero</h2><div class="financial-row"><span>Precio base</span><strong>@sale.PrecioBase.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</strong></div><div class="financial-row"><span>Forma de pago</span><strong>@Display(sale.MetodoPago)</strong></div><div class="financial-row"><span>Cuotas</span><strong>@sale.CantidadCuotas</strong></div><div class="financial-row"><span>Recargo aplicado</span><strong>@((sale.PrecioBase == 0 ? 0 : ((sale.PrecioFinal / sale.PrecioBase) - 1) * 100).ToString("0.##", CultureInfo.InvariantCulture))%</strong></div><div class="financial-total"><span>Total final</span><strong>@sale.PrecioFinal.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</strong></div><div class="financial-commission"><p>Detalles de comisión</p><div><span>Vendedor</span><strong>@sale.Vendedor.Nombre</strong></div><div><span>Tasa (@sale.PorcentajeComisionAplicado.ToString("0.###", CultureInfo.InvariantCulture)%)</span><strong>@sale.ComisionCalculada.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</strong></div></div><div class="financial-observations"><p>Observaciones</p><em>@(sale.Observaciones ?? "Sin observaciones")</em></div></aside>
    </div>
    @if (sale.Estado == EstadoVenta.Activa && User.IsInRole("Admin"))
    {
        <div class="detail-actions"><a class="btn btn-outline-secondary" asp-action="Index">Volver al listado</a><button class="btn btn-action-danger" type="button" data-bs-toggle="modal" data-bs-target="#cancel-sale-modal"><span class="material-symbols-rounded">cancel</span> Anular venta</button></div>
        <div class="modal fade" id="cancel-sale-modal" tabindex="-1" aria-labelledby="cancel-sale-title" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content cancellation-modal"><div class="modal-header"><div><h2 id="cancel-sale-title"><span class="material-symbols-rounded">warning</span> Anular venta #@sale.Id</h2><p>Esta acción requiere permisos de administrador y será registrada en la auditoría.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body"><h3>Resumen de operación</h3><div class="cancel-summary-grid"><div><small>Cliente</small><strong>@sale.Cliente.Nombre @sale.Cliente.Apellido</strong></div><div><small>Vehículo</small><strong>@sale.Vehiculo.Anio @sale.Vehiculo.Marca @sale.Vehiculo.Modelo</strong></div><div><small>Vendedor</small><strong>@sale.Vendedor.Nombre</strong></div><div><small>Precio / comisión</small><strong>@sale.PrecioFinal.ToString("C", CultureInfo.GetCultureInfo("es-AR")) · @sale.ComisionCalculada.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</strong></div></div><div class="cancellation-warning"><span class="material-symbols-rounded">info</span><span>El vehículo no cambiará de estado automáticamente. Deberás actualizarlo manualmente desde Gestión de Vehículos si corresponde.</span></div><form method="post" asp-action="Anular" asp-route-id="@sale.Id" id="cancel-sale-form">@Html.AntiForgeryToken()<label class="form-label" for="cancel-reason">Motivo de anulación <span class="required-dot">●</span></label><textarea class="form-control" id="cancel-reason" name="MotivoAnulacion" rows="4" required maxlength="1000" placeholder="Describí detalladamente el motivo de la anulación...">@Model.MotivoAnulacion</textarea><div class="modal-actions"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn btn-action-danger">Confirmar anulación</button></div></form></div></div></div></div>
    }
</div>
@functions { string Display(Enum value) => value switch { MetodoPago.Efectivo => "Efectivo", MetodoPago.Tarjeta => "Tarjeta", MetodoPago.FinanciacionPropia => "Financiación propia", TipoVehiculo.Sedan => "Sedán", TipoVehiculo.CuatroPuertas => "4 Puertas", TipoVehiculo.CuatroPorCuatro => "4x4", TipoVehiculo.Deportivo => "Deportivo", _ => value.ToString() }; }
