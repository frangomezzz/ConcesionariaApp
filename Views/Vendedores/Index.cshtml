@model PagedResult<VendedorListItem>
@{ ViewData["Title"] = "Gestión de Vendedores"; var buscar = Context.Request.Query["buscar"].ToString(); var activo = Context.Request.Query["activo"].ToString(); }
<div class="admin-page"><div class="page-heading d-flex justify-content-between align-items-start gap-3"><div><p class="eyebrow">EQUIPO COMERCIAL</p><h1>Gestión de Vendedores</h1><p class="page-subtitle">Administrá el equipo de ventas, sus accesos y estado general.</p></div><a class="btn btn-action-primary" asp-action="Nuevo"><span class="material-symbols-rounded">add</span> Nuevo vendedor</a></div>@if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }<form method="get" class="filter-card row g-3 align-items-end"><div class="col-md-6"><label class="form-label">Buscar vendedor</label><input name="buscar" value="@buscar" class="form-control" placeholder="Nombre o email" /></div><div class="col-md-3"><label class="form-label">Estado</label><select name="activo" class="form-select"><option value="">Todos los estados</option><option value="true" selected="@(activo == "true" ? "selected" : null)">Activos</option><option value="false" selected="@(activo == "false" ? "selected" : null)">Inactivos</option></select></div><div class="col-md-3 d-flex gap-2"><button class="btn btn-filter flex-grow-1" type="submit"><span class="material-symbols-rounded">filter_alt</span> Filtrar</button><a class="btn btn-filter" asp-action="Index">Limpiar</a></div></form><div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0 admin-table"><thead><tr><th>Nombre</th><th>Contacto</th><th>Antigüedad</th><th>Ventas</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach (var item in Model.Items) { var seller = item.Usuario; var months = Math.Max(0, (DateTime.Today.Year - seller.FechaAlta.Year) * 12 + DateTime.Today.Month - seller.FechaAlta.Month - (DateTime.Today.Day < seller.FechaAlta.Day ? 1 : 0)); <tr class="@(seller.Activo ? "" : "row-inactive")"><td><strong>@seller.Nombre</strong><small class="d-block text-muted">ID: @seller.Id</small></td><td>@seller.Email<small class="d-block text-muted">@seller.Telefono</small></td><td>@(months / 12 > 0 ? $"{months / 12} año(s) " : "")@(months % 12) mes(es)</td><td>@item.CantidadVentas</td><td><span class="status-badge @(seller.Activo ? "status-activo" : "status-inactivo")">@(seller.Activo ? "Activo" : "Inactivo")</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-action-primary" asp-action="Editar" asp-route-id="@seller.Id"><span class="material-symbols-rounded">edit</span> Editar</a> <a class="btn btn-sm btn-action-secondary" asp-action="RestablecerPassword" asp-route-id="@seller.Id"><span class="material-symbols-rounded">key</span> Contraseña</a>@if (seller.Activo) { <form class="d-inline" method="post" asp-action="Desactivar" asp-route-id="@seller.Id"><button class="btn btn-sm btn-action-danger" type="submit"><span class="material-symbols-rounded">block</span> Desactivar</button></form> } else { <form class="d-inline" method="post" asp-action="Reactivar" asp-route-id="@seller.Id"><button class="btn btn-sm btn-action-success" type="submit"><span class="material-symbols-rounded">restart_alt</span> Reactivar</button></form> }</td></tr> } @if (Model.Items.Count == 0) { <tr><td colspan="6" class="empty-state">No hay vendedores para los filtros seleccionados.</td></tr> }</tbody></table></div><div class="pagination-bar"><span>Mostrando @((Model.Page - 1) * Model.PageSize + (Model.TotalItems == 0 ? 0 : 1)) a @Math.Min(Model.Page * Model.PageSize, Model.TotalItems) de @Model.TotalItems vendedores</span><div class="pagination-links">@for (var i = 1; i <= Model.TotalPages; i++) { <a class="@(i == Model.Page ? "active" : "")" asp-action="Index" asp-route-page="@i" asp-route-buscar="@buscar" asp-route-activo="@activo">@i</a> }</div></div></div></div>
