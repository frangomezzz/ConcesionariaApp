@model ClienteFormViewModel
@{ var editing = Model.Id > 0; ViewData["Title"] = editing ? "Editar Cliente" : "Nuevo Cliente"; }
<div class="form-page narrow-form"><div class="breadcrumb-line"><a asp-action="Index">← Clientes</a><span>/</span><strong>@ViewData["Title"]</strong></div><div class="form-card"><div class="form-card-heading"><p class="eyebrow">CLIENTES</p><h1>@ViewData["Title"]</h1><p>Registrá la información de contacto del cliente.</p></div><form method="post" asp-action="@(editing ? "Editar" : "Nuevo")" asp-route-id="@(editing ? Model.Id : null)"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-4"><div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" placeholder="Ej. Juan" /><span asp-validation-for="Nombre" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Apellido" class="form-label"></label><input asp-for="Apellido" class="form-control" placeholder="Ej. Pérez" /><span asp-validation-for="Apellido" class="text-danger"></span></div><div class="col-md-6"><label asp-for="DNI" class="form-label"></label><input asp-for="DNI" class="form-control" placeholder="Ej. 28456789" /><span asp-validation-for="DNI" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" placeholder="Ej. 11-5555-5555" /><span asp-validation-for="Telefono" class="text-danger"></span></div><div class="col-12"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="cliente@email.com" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-12"><label asp-for="Direccion" class="form-label">Dirección <span class="text-muted">(opcional)</span></label><textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Calle, número, ciudad..."></textarea><span asp-validation-for="Direccion" class="text-danger"></span></div></div><div class="form-actions"><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a><button class="btn btn-success" type="submit">Guardar cliente</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
