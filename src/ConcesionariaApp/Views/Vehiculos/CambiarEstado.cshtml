@model VehiculoEstadoViewModel
@{ ViewData["Title"] = "Cambiar estado"; }
<div class="form-page narrow-form"><div class="form-card state-card"><div class="form-card-heading"><p class="eyebrow">VEHÍCULOS</p><h1>Cambiar estado</h1><p>@Model.Descripcion</p></div><form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><label class="form-label">Nuevo estado</label><div class="state-options">@foreach (var value in Enum.GetValues<EstadoVehiculo>()) { <label class="state-option"><input asp-for="Estado" type="radio" value="@value" /><span><strong>@Display(value)</strong><small>@(value == EstadoVehiculo.Disponible ? "Disponible para una nueva venta." : value == EstadoVehiculo.Reservado ? "Apartado temporalmente." : "Marcado como vendido.")</small></span></label> }</div><div class="alert alert-info">Cambiar el estado no genera ni anula ventas automáticamente.</div><div class="form-actions"><a class="btn btn-action-neutral" asp-action="Index">Cancelar</a><button class="btn btn-action-success" type="submit"><span class="material-symbols-rounded">check_circle</span> Confirmar cambio</button></div></form></div></div>
@functions { string Display(EstadoVehiculo value) => value switch { EstadoVehiculo.Disponible => "Disponible", EstadoVehiculo.Reservado => "Reservado", EstadoVehiculo.Vendido => "Vendido", _ => value.ToString() }; }
