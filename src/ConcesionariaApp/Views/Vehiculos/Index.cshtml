@model PagedResult<VehiculoListItem>
@{
    ViewData["Title"] = "Gestión de Vehículos";
    var tipo = Context.Request.Query["tipo"].ToString();
    var estado = Context.Request.Query["estado"].ToString();
    var activo = Context.Request.Query["activo"].ToString();
}
<div class="admin-page">
    <div class="page-heading d-flex justify-content-between align-items-start gap-3">
        <div><p class="eyebrow">INVENTARIO</p><h1>Gestión de Vehículos</h1><p class="page-subtitle">Administrá el inventario, estados y precios de la concesionaria.</p></div>
        <a class="btn btn-action-primary" asp-action="Nuevo"><span class="material-symbols-rounded">add</span> Nuevo vehículo</a>
    </div>
    @if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
    <form method="get" class="filter-card row g-3 align-items-end">
        <div class="col-md-3"><label class="form-label">Tipo</label><select name="tipo" class="form-select"><option value="">Todos los tipos</option>@foreach (var value in Enum.GetValues<TipoVehiculo>()) { <option value="@value" selected="@(tipo == value.ToString() ? "selected" : null)">@Display(value)</option> }</select></div>
        <div class="col-md-3"><label class="form-label">Estado</label><select name="estado" class="form-select"><option value="">Todos los estados</option>@foreach (var value in Enum.GetValues<EstadoVehiculo>()) { <option value="@value" selected="@(estado == value.ToString() ? "selected" : null)">@Display(value)</option> }</select></div>
        <div class="col-md-3"><label class="form-label">Registro</label><select name="activo" class="form-select"><option value="">Activos e inactivos</option><option value="true" selected="@(activo == "true" ? "selected" : null)">Activos</option><option value="false" selected="@(activo == "false" ? "selected" : null)">Inactivos</option></select></div>
        <div class="col-md-3 d-flex gap-2"><button class="btn btn-filter flex-grow-1" type="submit"><span class="material-symbols-rounded">filter_alt</span> Filtrar</button><a class="btn btn-filter" asp-action="Index">Limpiar</a></div>
    </form>
    <div class="table-card">
        <div class="table-responsive"><table class="table align-middle mb-0 admin-table"><thead><tr><th>Vehículo</th><th>Tipo / Condición</th><th>Identificación</th><th>Precio base</th><th>Estado</th><th>Registro</th><th class="text-end">Acciones</th></tr></thead><tbody>
        @foreach (var item in Model.Items)
        {
            var vehicle = item.Vehiculo;
            <tr class="@(vehicle.Activo ? "" : "row-inactive")"><td><strong>@vehicle.Marca @vehicle.Modelo</strong><small class="d-block text-muted">@vehicle.Anio</small></td><td>@Display(vehicle.Tipo)<small class="d-block"><span class="condition-badge">@(vehicle.EsUsado ? "Usado" : "0km")</span></small></td><td>@(vehicle.Patente ?? "Sin patentar")</td><td class="money">@vehicle.PrecioBase.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("es-AR"))</td><td><span class="status-badge status-@vehicle.Estado.ToString().ToLowerInvariant()">@Display(vehicle.Estado)</span></td><td><span class="status-badge @(vehicle.Activo ? "status-activo" : "status-inactivo")">@(vehicle.Activo ? "Activo" : "Inactivo")</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-action-primary" asp-action="Editar" asp-route-id="@vehicle.Id"><span class="material-symbols-rounded">edit</span> Editar</a> <a class="btn btn-sm btn-action-secondary" asp-action="CambiarEstado" asp-route-id="@vehicle.Id"><span class="material-symbols-rounded">sync_alt</span> Estado</a>@if (vehicle.Activo) { <form class="d-inline" method="post" asp-action="Desactivar" asp-route-id="@vehicle.Id"><button class="btn btn-sm btn-action-danger" type="submit"><span class="material-symbols-rounded">block</span> Desactivar</button></form> } else { <form class="d-inline" method="post" asp-action="Reactivar" asp-route-id="@vehicle.Id"><button class="btn btn-sm btn-action-success" type="submit"><span class="material-symbols-rounded">restart_alt</span> Reactivar</button></form> }</td></tr>
        }
        @if (Model.Items.Count == 0) { <tr><td colspan="7" class="empty-state">No hay vehículos para los filtros seleccionados.</td></tr> }
        </tbody></table></div>
        <partial name="_Pagination" model="new { Model, tipo, estado, activo }" />
    </div>
</div>
@functions { string Display(Enum value) => value switch { TipoVehiculo.Sedan => "Sedán", TipoVehiculo.CuatroPuertas => "4 Puertas", TipoVehiculo.CuatroPorCuatro => "4x4", TipoVehiculo.Deportivo => "Deportivo", EstadoVehiculo.Disponible => "Disponible", EstadoVehiculo.Reservado => "Reservado", EstadoVehiculo.Vendido => "Vendido", _ => value.ToString() }; }
