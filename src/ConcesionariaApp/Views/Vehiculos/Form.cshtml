@model VehiculoFormViewModel
@{
    var editing = Model.Id > 0;
    ViewData["Title"] = editing ? "Editar Vehículo" : "Nuevo Vehículo";
}
<div class="form-page narrow-form"><div class="breadcrumb-line"><a asp-action="Index">← Vehículos</a><span>/</span><strong>@ViewData["Title"]</strong></div><div class="form-card"><div class="form-card-heading"><p class="eyebrow">VEHÍCULOS</p><h1>@ViewData["Title"]</h1><p>@(editing ? "Actualizá la información del inventario." : "Completá los datos para registrar un nuevo vehículo.")</p></div><form method="post" asp-action="@(editing ? "Editar" : "Nuevo")" asp-route-id="@(editing ? Model.Id : null)"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-4"><div class="col-md-6"><label asp-for="Marca" class="form-label"></label><input asp-for="Marca" class="form-control" /><span asp-validation-for="Marca" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Modelo" class="form-label"></label><input asp-for="Modelo" class="form-control" /><span asp-validation-for="Modelo" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Anio" class="form-label">Año</label><input asp-for="Anio" class="form-control" /><span asp-validation-for="Anio" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Tipo" class="form-label"></label><select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoVehiculo>()" class="form-select" disabled="@(Model.TieneVentas ? "disabled" : null)"></select>@if (Model.TieneVentas) { <input type="hidden" asp-for="Tipo" /> <small class="locked-note">🔒 No editable: este vehículo ya tiene ventas asociadas.</small> }<span asp-validation-for="Tipo" class="text-danger"></span></div><div class="col-md-6"><label class="form-label d-block">Condición</label><div class="radio-row"><label><input asp-for="EsUsado" type="radio" value="false" /> 0km</label><label><input asp-for="EsUsado" type="radio" value="true" /> Usado</label></div></div><div class="col-md-6"><label asp-for="Patente" class="form-label">Patente / matrícula</label><input asp-for="Patente" class="form-control" placeholder="Vacío si es 0km sin patentar" /><span asp-validation-for="Patente" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Color" class="form-label"></label><input asp-for="Color" class="form-control" /><span asp-validation-for="Color" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Kilometraje" class="form-label"></label><div class="input-group"><input asp-for="Kilometraje" class="form-control" /><span class="input-group-text">KM</span></div><span asp-validation-for="Kilometraje" class="text-danger"></span></div><div class="col-md-6"><label asp-for="PrecioBase" class="form-label"></label><div class="input-group"><span class="input-group-text">$</span><input asp-for="PrecioBase" class="form-control" disabled="@(Model.TieneVentas ? "disabled" : null)" />@if (Model.TieneVentas) { <input type="hidden" asp-for="PrecioBase" /> }</div>@if (Model.TieneVentas) { <small class="locked-note">🔒 No editable: este vehículo ya tiene ventas asociadas.</small> }<span asp-validation-for="PrecioBase" class="text-danger"></span></div><div class="col-md-6"><label asp-for="FechaIngreso" class="form-label"></label><input asp-for="FechaIngreso" type="date" class="form-control" /><span asp-validation-for="FechaIngreso" class="text-danger"></span></div></div><hr /><div class="form-actions"><a class="btn btn-action-neutral" asp-action="Index">Cancelar</a><button class="btn btn-action-success" type="submit"><span class="material-symbols-rounded">save</span> Guardar @(editing ? "cambios" : "vehículo")</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
