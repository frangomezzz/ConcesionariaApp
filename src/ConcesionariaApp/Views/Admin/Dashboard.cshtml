@model DashboardPageViewModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    ViewData["Title"] = "Dashboard Admin";
    var initialData = JsonSerializer.Serialize(Model.Data, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default
    });
}

<div class="dashboard-page" data-dashboard-root data-dashboard-role="admin" data-data-url="@Model.DataUrl">
    <div class="dashboard-heading">
        <div>
            <p class="eyebrow">ADMINISTRACIÓN</p>
            <h1>Dashboard Admin</h1>
            <p class="page-subtitle">Resumen comercial y rendimiento de la concesionaria.</p>
        </div>
        <div class="dashboard-filter-card">
            <label class="visually-hidden" for="dashboard-preset">Rango de fechas</label>
            <select id="dashboard-preset" class="form-select dashboard-preset">
                <option value="este-mes">Este mes</option>
                <option value="ultimos-3-meses">Últimos 3 meses</option>
                <option value="ultimo-anio">Último año</option>
                <option value="personalizado">Personalizado</option>
            </select>
            <div class="dashboard-custom-range" hidden>
                <label class="visually-hidden" for="dashboard-desde">Desde</label>
                <input id="dashboard-desde" class="form-control" type="date" value="@Model.Desde.ToString("yyyy-MM-dd")" />
                <span aria-hidden="true">a</span>
                <label class="visually-hidden" for="dashboard-hasta">Hasta</label>
                <input id="dashboard-hasta" class="form-control" type="date" value="@Model.Hasta.ToString("yyyy-MM-dd")" />
            </div>
        </div>
    </div>

    <div class="metric-grid dashboard-admin-metrics">
        <article class="metric-card">
            <div class="metric-icon metric-icon-blue"><span class="material-symbols-rounded">trending_up</span></div>
            <p id="sales-label">Ventas de este mes</p>
            <strong data-metric="sales">0</strong>
            <small>Ventas activas en el período</small>
        </article>
        <article class="metric-card">
            <div class="metric-icon metric-icon-blue"><span class="material-symbols-rounded">attach_money</span></div>
            <p>Total facturado</p>
            <strong data-metric="total-facturado">$ 0</strong>
            <small>Precio final de ventas activas</small>
        </article>
        <article class="metric-card">
            <div class="metric-icon metric-icon-gray"><span class="material-symbols-rounded">directions_car</span></div>
            <p>Vehículos vendidos</p>
            <strong data-metric="vehiculos-vendidos">0</strong>
            <small>Un vehículo por venta</small>
        </article>
        <article class="metric-card">
            <div class="metric-icon metric-icon-red"><span class="material-symbols-rounded">account_balance_wallet</span></div>
            <p>Comisiones pagadas</p>
            <strong data-metric="comisiones">$ 0</strong>
            <small>Snapshot de cada venta activa</small>
        </article>
        <article class="metric-card">
            <div class="metric-icon metric-icon-gray"><span class="material-symbols-rounded">groups</span></div>
            <p>Vendedores activos</p>
            <strong data-metric="vendedores-activos">0</strong>
            <small>Dato actual, independiente del rango</small>
        </article>
    </div>

    <div class="dashboard-chart-grid dashboard-admin-charts">
        <section class="dashboard-card dashboard-chart-card dashboard-chart-wide">
            <div class="dashboard-card-heading"><h2>Ventas por mes</h2><span class="material-symbols-rounded">more_horiz</span></div>
            <div class="dashboard-chart-wrap"><canvas id="monthly-sales-chart" aria-label="Ventas activas por mes"></canvas></div>
        </section>
        <section class="dashboard-card dashboard-chart-card">
            <div class="dashboard-card-heading"><h2>Vehículos más vendidos</h2><span class="material-symbols-rounded">more_horiz</span></div>
            <div class="dashboard-chart-wrap dashboard-doughnut-wrap"><canvas id="vehicle-type-chart" aria-label="Vehículos vendidos por tipo"></canvas></div>
        </section>
        <section class="dashboard-card dashboard-chart-card">
            <div class="dashboard-card-heading"><h2>Ventas por vendedor</h2><span class="material-symbols-rounded">more_horiz</span></div>
            <div class="dashboard-chart-wrap"><canvas id="seller-sales-chart" aria-label="Ventas activas por vendedor"></canvas></div>
        </section>
        <section class="dashboard-card dashboard-chart-card dashboard-chart-wide">
            <div class="dashboard-card-heading"><h2>Comisiones por vendedor</h2><span class="material-symbols-rounded">more_horiz</span></div>
            <div class="dashboard-chart-wrap"><canvas id="seller-commission-chart" aria-label="Comisiones por vendedor"></canvas></div>
        </section>
    </div>

    <section class="dashboard-card dashboard-sales-card">
        <div class="dashboard-card-heading dashboard-table-heading"><h2>Últimas ventas</h2><a asp-controller="Ventas" asp-action="Index">Ver todas</a></div>
        <div class="table-responsive"><table class="table align-middle mb-0 admin-table dashboard-sales-table"><thead><tr><th>Fecha</th><th>Cliente</th><th>Vehículo</th><th>Vendedor</th><th>Precio final</th><th>Comisión</th><th>Estado</th></tr></thead><tbody data-sales-rows></tbody></table></div>
    </section>
</div>

<script type="application/json" data-dashboard-initial>@Html.Raw(initialData)</script>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
