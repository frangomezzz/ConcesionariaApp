@model MisVentasViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Ventas";
    var desde = Model.Desde?.ToString("yyyy-MM-dd");
    var hasta = Model.Hasta?.ToString("yyyy-MM-dd");
}
<div class="admin-page sales-list-page">
    <div class="page-heading"><p class="eyebrow">GESTIÓN COMERCIAL</p><h1>Ventas</h1><p class="page-subtitle">Consultá todas las operaciones y administrá sus anulaciones.</p></div>
    @if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
    <form method="get" class="filter-card row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Desde</label><input type="date" name="desde" value="@desde" class="form-control" /></div><div class="col-md-3"><label class="form-label">Hasta</label><input type="date" name="hasta" value="@hasta" class="form-control" /></div><div class="col-md-3"><label class="form-label">Buscar</label><input type="text" name="buscar" value="@Model.BuscarVehiculo" class="form-control" placeholder="Cliente, vehículo o vendedor" /></div><div class="col-md-2"><label class="form-label">Estado</label><select name="estado" class="form-select"><option value="">Todos</option><option value="Activa" selected="@(Model.Estado == EstadoVenta.Activa ? "selected" : null)">Activa</option><option value="Anulada" selected="@(Model.Estado == EstadoVenta.Anulada ? "selected" : null)">Anulada</option></select></div><div class="col-md-1"><button class="btn btn-filter w-100" type="submit"><span class="material-symbols-rounded">filter_alt</span></button></div></form>
    <div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0 admin-table sales-table"><thead><tr><th>Fecha</th><th>Cliente</th><th>Vehículo</th><th>Vendedor</th><th>Precio final</th><th>Comisión</th><th>Estado</th><th></th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr class="@(item.Estado == EstadoVenta.Anulada ? "row-inactive" : "")"><td>@item.FechaVenta.ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("es-AR"))</td><td><strong>@item.Cliente</strong><small class="d-block text-muted">@item.ClienteEmail</small></td><td><strong>@item.Vehiculo</strong><small class="d-block text-muted">@item.VehiculoIdentificacion</small></td><td>@item.Vendedor</td><td class="money">@item.PrecioFinal.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</td><td class="money">@item.Comision.ToString("C", CultureInfo.GetCultureInfo("es-AR"))</td><td><span class="status-badge @(item.Estado == EstadoVenta.Activa ? "status-activo" : "status-anulada")">@(item.Estado == EstadoVenta.Activa ? "Activa" : "Anulada")</span></td><td class="text-end"><a class="btn btn-sm btn-action-secondary" asp-action="Detalle" asp-route-id="@item.Id">Ver detalle</a></td></tr> } @if (Model.Items.Count == 0) { <tr><td colspan="8" class="empty-state">No hay ventas para los filtros seleccionados.</td></tr> }</tbody></table></div><partial name="_SalesPagination" model="Model" /></div>
</div>
